{
  "expo": {
    "name": "QuickBite",
    "slug": "quickbite-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "quickbite",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#06060b"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.quickbite.mobile",
      "infoPlist": {
        "UIBackgroundModes": ["location", "remote-notification"],
        "NSLocationWhenInUseUsageDescription": "QuickBite uses your location to show nearby restaurants and deliver your orders.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Drivers share their location while delivering orders."
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.quickbite.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#06060b"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow QuickBite to use your location to find nearby restaurants and track deliveries.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "urlScheme": "quickbite",
          "enableGooglePay": false,
          "merchantIdentifier": ""
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "tsconfigPaths": true
    }
  }
}
