# ------------------------------------------------------------------
# Food Delivery Platform — Backend environment variables
# Copy to .env and fill real values. NEVER commit .env
# ------------------------------------------------------------------

DATABASE_URL=postgresql://user:password@localhost:5432/fooddelivery
JWT_SECRET=your_jwt_secret
JWT_REFRESH_SECRET=your_jwt_refresh_secret
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass
PORT=5000

# --- optional / extra knobs (safe defaults exist in src/config/env.js) ---
CLIENT_WEB_ORIGIN=http://localhost:3000
NODE_ENV=development
OTP_MOCK=true
ORDER_AUTO_CANCEL_MINUTES=15
DRIVER_REQUEST_TIMEOUT_SECONDS=45
PLATFORM_CURRENCY=USD
