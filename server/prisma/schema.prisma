// ==================================================================
// Food Delivery Platform — Prisma schema (PostgreSQL)
// ==================================================================

generator client {
  provider       = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

// -----------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  ADMIN
  OPS_MANAGER
  SUPPORT_AGENT
  RESTAURANT_OWNER
  RESTAURANT_STAFF
  DRIVER
  CUSTOMER
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  BANNED
  DELETED
}

enum RestaurantStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SUSPENDED
}

enum BranchStatus {
  OPEN
  CLOSED
  BUSY
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  DRIVER_ASSIGNED
  DRIVER_EN_ROUTE_TO_RESTAURANT
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CARD
  WALLET
  CASH
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  ORDER_PAYMENT
  ORDER_REFUND
  WALLET_TOPUP
  DRIVER_EARNING
  RESTAURANT_PAYOUT
  ADMIN_ADJUSTMENT
}

enum PayoutStatus {
  REQUESTED
  APPROVED
  PROCESSING
  PAID
  REJECTED
}

enum VehicleType {
  BIKE
  MOTORCYCLE
  CAR
}

enum DriverAvailability {
  ONLINE
  OFFLINE
  ON_DELIVERY
}

enum DeliveryRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum ItemAvailability {
  AVAILABLE
  UNAVAILABLE
  SOLD_OUT
}

enum ReviewReportStatus {
  OPEN
  REVIEWED
  REMOVED
  KEPT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
  ESCALATED
}

enum TicketCategory {
  ORDER_ISSUE
  PAYMENT_ISSUE
  DELIVERY_ISSUE
  ACCOUNT_ISSUE
  RESTAURANT_ISSUE
  DRIVER_ISSUE
  OTHER
}

enum NotificationChannel {
  PUSH
  EMAIL
  IN_APP
  WEB_PUSH
}

enum CouponType {
  PERCENTAGE
  FIXED
  FREE_DELIVERY
}

enum MenuSlot {
  BREAKFAST
  LUNCH
  DINNER
  ALL_DAY
}

// -----------------------------------------------------------------
// AUTH / USERS
// -----------------------------------------------------------------

model User {
  id              String     @id @default(uuid())
  role            Role
  email           String?    @unique
  phone           String?    @unique
  passwordHash    String?
  googleId        String?    @unique
  fullName        String
  avatarUrl       String?
  status          UserStatus @default(PENDING)
  isPhoneVerified Boolean    @default(false)
  otpCode         String?
  otpExpiresAt    DateTime?
  locale          String     @default("en")
  darkMode        Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  refreshTokens       RefreshToken[]
  deviceTokens        DeviceToken[]
  addresses           Address[]
  notifications       Notification[]
  notificationPref    NotificationPreference?
  wallet              Wallet?
  reviews             Review[]
  reviewVotes         ReviewVote[]
  reviewReports       ReviewReport[]
  favorites           Favorite[]
  orders              Order[]          @relation("CustomerOrders")
  groupOrders         GroupOrder[]
  chatMessages        ChatMessage[]
  tickets             Ticket[]         @relation("TicketCreator")
  ticketMessages      TicketMessage[]
  auditLogs           AuditLog[]
  ownedRestaurants    Restaurant[]     @relation("RestaurantOwner")
  staffBranches       BranchStaff[]
  managedReviews      ReviewResponse[]
  driverProfile       DriverProfile?
  loyaltyTransactions LoyaltyTransaction[]
  promoUsages         PromoCodeUsage[]
  payments            Payment[]        @relation("PaymentCustomer")

  @@index([role, status])
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String // expo | ios | android | web
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Address {
  id         String   @id @default(uuid())
  userId     String
  label      String   @default("Home")
  fullName   String
  phone      String?
  line1      String
  line2      String?
  city       String
  state      String?
  country    String
  postalCode String?
  lat        Decimal  @db.Decimal(10, 7)
  lng        Decimal  @db.Decimal(10, 7)
  notes      String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders     Order[]

  @@index([userId])
}

// -----------------------------------------------------------------
// RESTAURANTS / BRANCHES / MENU
// -----------------------------------------------------------------

model Cuisine {
  id          String  @id @default(uuid())
  name        String  @unique
  slug        String  @unique
  iconUrl     String?
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)
  createdAt   DateTime @default(now())
  restaurants RestaurantCuisine[]

  @@index([isActive, sortOrder])
}

model Restaurant {
  id              String           @id @default(uuid())
  ownerId         String
  name            String
  slug            String           @unique
  description     String?
  logoUrl         String?
  coverUrl        String?
  phone           String?
  email           String?
  status          RestaurantStatus @default(PENDING_APPROVAL)
  rejectionReason String?
  isFeatured      Boolean          @default(false)
  featuredUntil   DateTime?
  commissionRate  Decimal?         @db.Decimal(5, 2) // per-restaurant override, %
  licenseDocUrl   String?
  foodSafetyUrl   String?
  taxIdDocUrl     String?
  avgRating       Float            @default(0)
  reviewCount     Int              @default(0)
  totalOrders     Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  owner    User                @relation("RestaurantOwner", fields: [ownerId], references: [id])
  cuisines RestaurantCuisine[]
  branches Branch[]
  payouts  RestaurantPayout[]
  reviews  Review[]

  @@index([status, isFeatured])
}

model RestaurantCuisine {
  restaurantId String
  cuisineId    String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  cuisine      Cuisine    @relation(fields: [cuisineId], references: [id], onDelete: Cascade)

  @@id([restaurantId, cuisineId])
}

model Branch {
  id                String       @id @default(uuid())
  restaurantId      String
  name              String       @default("Main")
  phone             String?
  addressLine1      String
  city              String
  country           String
  postalCode        String?
  lat               Decimal      @db.Decimal(10, 7)
  lng               Decimal      @db.Decimal(10, 7)
  status            BranchStatus @default(OPEN)
  deliveryRadiusKm  Decimal      @default(5) @db.Decimal(5, 2)
  minOrderAmount    Decimal      @default(5) @db.Decimal(10, 2)
  deliveryFee       Decimal      @default(1.5) @db.Decimal(10, 2)
  freeDeliveryAbove Decimal?     @db.Decimal(10, 2)
  prepTimeMinutes   Int          @default(20)
  serviceFeePercent Decimal      @default(5) @db.Decimal(5, 2)
  isOpenNow         Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  restaurant  Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  hours       OperatingHour[]
  staff       BranchStaff[]
  categories  MenuCategory[]
  items       MenuItem[]
  orders      Order[]
  deliveries  Delivery[]
  combos      Combo[]
  surgeZones  SurgeZone[]      @relation("SurgeHomeBranch")

  @@index([restaurantId])
}

model OperatingHour {
  id        String  @id @default(uuid())
  branchId  String
  dayOfWeek Int // 0=Sunday .. 6=Saturday
  openTime  String // "09:00"
  closeTime String // "23:30"
  isClosed  Boolean @default(false)
  branch    Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, dayOfWeek])
}

model BranchStaff {
  userId   String
  branchId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
}

model MenuCategory {
  id        String   @id @default(uuid())
  branchId  String
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  slot      MenuSlot @default(ALL_DAY)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  items     MenuItem[]

  @@index([branchId, sortOrder])
}

model MenuItem {
  id              String           @id @default(uuid())
  branchId        String
  categoryId      String
  name            String
  description     String?
  price           Decimal          @db.Decimal(10, 2)
  compareAtPrice  Decimal?         @db.Decimal(10, 2) // special offer price
  offerValidFrom  DateTime?
  offerValidTo    DateTime?
  imageUrls       String[]
  prepTimeMinutes Int              @default(10)
  availability    ItemAvailability @default(AVAILABLE)
  isBestSeller    Boolean          @default(false)
  isVegan         Boolean          @default(false)
  isVegetarian    Boolean          @default(false)
  isSpicy         Boolean          @default(false)
  isGlutenFree    Boolean          @default(false)
  isNew           Boolean          @default(false)
  calories        Int?
  sortOrder       Int              @default(0)
  slot            MenuSlot         @default(ALL_DAY)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  branch     Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  category   MenuCategory        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  variants   ItemVariant[]
  addOns     ItemAddOn[]
  comboItems ComboItem[]
  orderItems OrderItem[]
  reviews    Review[]
  favorites  Favorite[]

  @@index([branchId, categoryId])
  @@index([availability])
}

model ItemVariant {
  id         String   @id @default(uuid())
  itemId     String
  name       String // "Size"
  optionType String   @default("single") // single | multiple
  sortOrder  Int      @default(0)
  item       MenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  options    ItemVariantOption[]

  @@index([itemId])
}

model ItemVariantOption {
  id            String      @id @default(uuid())
  variantId     String
  label         String // "Large"
  priceModifier Decimal     @default(0) @db.Decimal(10, 2)
  isDefault     Boolean     @default(false)
  variant       ItemVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  orderItems    OrderItem[]

  @@index([variantId])
}

model ItemAddOn {
  id         String    @id @default(uuid())
  itemId     String
  name       String // "Extra cheese"
  price      Decimal   @default(0) @db.Decimal(10, 2)
  isRequired Boolean   @default(false)
  item       MenuItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([itemId])
}

model Combo {
  id          String   @id @default(uuid())
  branchId    String
  name        String
  description String?
  comboPrice  Decimal  @db.Decimal(10, 2)
  imageUrls   String[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  items       ComboItem[]

  @@index([branchId])
}

model ComboItem {
  id       String   @id @default(uuid())
  comboId  String
  itemId   String
  quantity Int      @default(1)
  combo    Combo    @relation(fields: [comboId], references: [id], onDelete: Cascade)
  item     MenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([comboId])
}

// -----------------------------------------------------------------
// ORDERS
// -----------------------------------------------------------------

model Order {
  id                  String        @id @default(uuid())
  orderNumber         String        @unique
  customerId          String
  branchId            String
  addressId           String
  status              OrderStatus   @default(PLACED)
  itemsTotal          Decimal       @db.Decimal(10, 2)
  deliveryFee         Decimal       @db.Decimal(10, 2)
  serviceFee          Decimal       @db.Decimal(10, 2)
  platformFee         Decimal       @default(0) @db.Decimal(10, 2)
  surgeMultiplier     Decimal       @default(1) @db.Decimal(4, 2)
  discountTotal       Decimal       @default(0) @db.Decimal(10, 2)
  taxTotal            Decimal       @default(0) @db.Decimal(10, 2)
  total               Decimal       @db.Decimal(10, 2)
  commissionAmount    Decimal       @default(0) @db.Decimal(10, 2)
  restaurantEarning   Decimal       @default(0) @db.Decimal(10, 2)
  paymentMethod       PaymentMethod
  paymentStatus       PaymentStatus @default(PENDING)
  promoCodeId         String?
  loyaltyPointsUsed   Int           @default(0)
  loyaltyPointsEarned Int           @default(0)
  specialInstructions String?
  estimatedDeliveryAt DateTime?
  scheduledFor        DateTime?
  confirmedAt         DateTime?
  pickedUpAt          DateTime?
  deliveredAt         DateTime?
  cancelledAt         DateTime?
  cancelReason        String?
  cancelledBy         String?
  autoCancelled       Boolean       @default(false)
  restaurantRating    Int?
  driverRating        Int?
  distanceKm          Decimal?      @db.Decimal(8, 3)
  dropoffLat          Decimal       @db.Decimal(10, 7)
  dropoffLng          Decimal       @db.Decimal(10, 7)
  groupOrderId        String?
  proofPhotoUrl       String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  customer     User              @relation("CustomerOrders", fields: [customerId], references: [id])
  branch       Branch            @relation(fields: [branchId], references: [id])
  address      Address           @relation(fields: [addressId], references: [id])
  promoCode    PromoCode?        @relation(fields: [promoCodeId], references: [id])
  groupOrder   GroupOrder?       @relation(fields: [groupOrderId], references: [id])
  items        OrderItem[]
  statusLogs   OrderStatusLog[]
  payments     Payment[]
  refund       Refund?
  delivery     Delivery?
  reviews      Review[]
  chatMessages ChatMessage[]
  tickets      Ticket[]
  loyaltyTx    LoyaltyTransaction[]

  @@index([customerId, createdAt])
  @@index([branchId, status])
  @@index([status, createdAt])
  @@index([orderNumber])
}

model OrderItem {
  id                  String  @id @default(uuid())
  orderId             String
  menuItemId          String
  nameSnapshot        String
  priceSnapshot       Decimal @db.Decimal(10, 2)
  quantity            Int
  addOnsTotal         Decimal @default(0) @db.Decimal(10, 2)
  variantTotal        Decimal @default(0) @db.Decimal(10, 2)
  lineTotal           Decimal @db.Decimal(10, 2)
  specialInstructions String?
  variantOptionId     String?
  addOnId             String?

  order         Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item          MenuItem            @relation(fields: [menuItemId], references: [id])
  variantOption ItemVariantOption?  @relation(fields: [variantOptionId], references: [id])
  addOn         ItemAddOn?          @relation(fields: [addOnId], references: [id])

  @@index([orderId])
}

model OrderStatusLog {
  id        String      @id @default(uuid())
  orderId   String
  status    OrderStatus
  note      String?
  changedBy String?
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model GroupOrder {
  id       String   @id @default(uuid())
  hostId   String
  branchId String
  code     String   @unique
  isActive Boolean  @default(true)
  createdAt DateTime @default(now())
  host     User     @relation(fields: [hostId], references: [id])
  orders   Order[]

  @@index([hostId])
}

// -----------------------------------------------------------------
// DELIVERY / DRIVERS
// -----------------------------------------------------------------

model DriverProfile {
  userId           String             @id
  availability     DriverAvailability @default(OFFLINE)
  vehicleType      VehicleType        @default(MOTORCYCLE)
  vehicleModel     String?
  vehiclePlate     String?
  licenseDocUrl    String?
  insuranceDocUrl  String?
  photoDocUrl      String?
  idDocUrl         String?
  approvalStatus   RestaurantStatus   @default(PENDING_APPROVAL)
  rejectionReason  String?
  isSuspended      Boolean            @default(false)
  suspensionReason String?
  totalDeliveries  Int                @default(0)
  completionRate   Float              @default(0)
  acceptanceRate   Float              @default(0)
  onTimeRate       Float              @default(0)
  avgRating        Float              @default(0)
  reviewCount      Int                @default(0)
  earningsBalance  Decimal            @default(0) @db.Decimal(12, 2)
  lastLat          Decimal?           @db.Decimal(10, 7)
  lastLng          Decimal?           @db.Decimal(10, 7)
  lastSeenAt       DateTime?
  updatedAt        DateTime           @updatedAt

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries Delivery[]
  requests   DeliveryRequest[]
  payouts    DriverPayout[]
  reviews    Review[]

  @@index([availability, approvalStatus])
}

model Delivery {
  id              String      @id @default(uuid())
  orderId         String      @unique
  driverId        String?
  branchId        String
  status          OrderStatus @default(PLACED)
  pickupLat       Decimal     @db.Decimal(10, 7)
  pickupLng       Decimal     @db.Decimal(10, 7)
  dropoffLat      Decimal     @db.Decimal(10, 7)
  dropoffLng      Decimal     @db.Decimal(10, 7)
  distanceKm      Decimal?    @db.Decimal(8, 3)
  durationMin     Int?
  baseFee         Decimal     @default(0) @db.Decimal(10, 2)
  distanceBonus   Decimal     @default(0) @db.Decimal(10, 2)
  platformCut     Decimal     @default(0) @db.Decimal(10, 2)
  driverEarning   Decimal     @default(0) @db.Decimal(10, 2)
  surgeMultiplier Decimal     @default(1) @db.Decimal(4, 2)
  assignedAt      DateTime?
  pickedUpAt      DateTime?
  deliveredAt     DateTime?
  proofPhotoUrl   String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driver    DriverProfile?  @relation(fields: [driverId], references: [userId])
  branch    Branch          @relation(fields: [branchId], references: [id])
  requests  DeliveryRequest[]
  locations DriverLocation[]

  @@index([driverId, status])
  @@index([status])
}

model DeliveryRequest {
  id           String                @id @default(uuid())
  deliveryId   String
  driverId     String
  status       DeliveryRequestStatus @default(PENDING)
  expiresAt    DateTime
  respondedAt  DateTime?
  rejectReason String?
  createdAt    DateTime              @default(now())
  delivery     Delivery              @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  driver       DriverProfile         @relation(fields: [driverId], references: [userId], onDelete: Cascade)

  @@index([driverId, status])
  @@index([deliveryId])
}

model DriverLocation {
  id         String   @id @default(uuid())
  deliveryId String
  lat        Decimal  @db.Decimal(10, 7)
  lng        Decimal  @db.Decimal(10, 7)
  heading    Float?
  speed      Float?
  recordedAt DateTime @default(now())
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId, recordedAt])
}

model DriverPayout {
  id          String        @id @default(uuid())
  driverId    String
  amount      Decimal       @db.Decimal(12, 2)
  method      String        @default("bank_transfer")
  accountInfo String?
  status      PayoutStatus  @default(REQUESTED)
  processedBy String?
  processedAt DateTime?
  createdAt   DateTime      @default(now())
  driver      DriverProfile @relation(fields: [driverId], references: [userId], onDelete: Cascade)

  @@index([driverId, status])
}

model RestaurantPayout {
  id           String         @id @default(uuid())
  restaurantId String
  periodFrom   DateTime
  periodTo     DateTime
  grossAmount  Decimal        @db.Decimal(12, 2)
  commission   Decimal        @db.Decimal(12, 2)
  netAmount    Decimal        @db.Decimal(12, 2)
  status       PayoutStatus   @default(REQUESTED)
  processedBy  String?
  processedAt  DateTime?
  createdAt    DateTime       @default(now())
  restaurant   Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, status])
}

// -----------------------------------------------------------------
// PAYMENTS / WALLET / PROMO / LOYALTY
// -----------------------------------------------------------------

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  balance   Decimal  @default(0) @db.Decimal(12, 2)
  currency  String   @default("USD")
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  txns      WalletTransaction[]
}

model WalletTransaction {
  id           String          @id @default(uuid())
  walletId     String
  type         TransactionType
  amount       Decimal         @db.Decimal(12, 2) // + credit / - debit
  balanceAfter Decimal         @db.Decimal(12, 2)
  reference    String? // orderId / stripeId
  note         String?
  createdAt    DateTime        @default(now())
  wallet       Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
}

model Payment {
  id              String        @id @default(uuid())
  orderId         String
  customerId      String
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  amount          Decimal       @db.Decimal(12, 2)
  currency        String        @default("USD")
  stripePaymentId String?
  stripeIntentId  String?
  walletTxnId     String?
  gatewayResponse Json?
  failureReason   String?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  order           Order         @relation(fields: [orderId], references: [id])
  customer        User          @relation("PaymentCustomer", fields: [customerId], references: [id])
  refund          Refund?

  @@index([orderId])
  @@index([status, createdAt])
}

model Refund {
  id             String        @id @default(uuid())
  paymentId      String        @unique
  orderId        String        @unique
  amount         Decimal       @db.Decimal(12, 2)
  isPartial      Boolean       @default(false)
  reason         String?
  status         PaymentStatus @default(PENDING)
  stripeRefundId String?
  processedBy    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  payment        Payment       @relation(fields: [paymentId], references: [id])
  order          Order         @relation(fields: [orderId], references: [id])
}

model PromoCode {
  id             String     @id @default(uuid())
  code           String     @unique
  description    String?
  type           CouponType
  value          Decimal    @db.Decimal(10, 2)
  minOrderAmount Decimal    @default(0) @db.Decimal(10, 2)
  maxDiscount    Decimal?   @db.Decimal(10, 2)
  usageLimit     Int?
  usagePerUser   Int?       @default(1)
  usedCount      Int        @default(0)
  restaurantId   String? // null = platform-wide
  isActive       Boolean    @default(true)
  startsAt       DateTime
  expiresAt      DateTime
  createdBy      String?
  createdAt      DateTime   @default(now())
  usages         PromoCodeUsage[]
  orders         Order[]

  @@index([isActive, startsAt, expiresAt])
}

model PromoCodeUsage {
  id      String    @id @default(uuid())
  promoId String
  userId  String
  orderId String?
  usedAt  DateTime  @default(now())
  promo   PromoCode @relation(fields: [promoId], references: [id], onDelete: Cascade)
  user    User      @relation(fields: [userId], references: [id])

  @@index([promoId, userId])
}

model LoyaltyTransaction {
  id           String          @id @default(uuid())
  userId       String
  orderId      String?
  type         TransactionType // DEPOSIT=earn, WITHDRAWAL=redeem
  points       Int // + earn / - redeem
  balanceAfter Int
  note         String?
  createdAt    DateTime        @default(now())
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  order        Order?          @relation(fields: [orderId], references: [id])

  @@index([userId, createdAt])
}

// -----------------------------------------------------------------
// REVIEWS / FAVORITES
// -----------------------------------------------------------------

model Review {
  id          String   @id @default(uuid())
  authorId    String
  restaurantId String
  branchId    String?
  orderId     String?
  menuItemId  String?
  driverId    String?
  type        String   @default("restaurant") // restaurant | driver | dish
  rating      Int // 1..5
  comment     String?
  photoUrls   String[]
  helpfulCount Int     @default(0)
  isAbusiveFlagged Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author     User            @relation(fields: [authorId], references: [id])
  restaurant Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  order      Order?          @relation(fields: [orderId], references: [id])
  item       MenuItem?       @relation(fields: [menuItemId], references: [id])
  driver     DriverProfile?  @relation(fields: [driverId], references: [userId])
  response   ReviewResponse?
  votes      ReviewVote[]
  reports    ReviewReport[]

  @@index([restaurantId, createdAt])
  @@index([driverId])
  @@index([orderId])
}

model ReviewResponse {
  id        String   @id @default(uuid())
  reviewId  String   @unique
  userId    String // restaurant owner/staff who replied
  message   String
  createdAt DateTime @default(now())
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
}

model ReviewVote {
  id        String   @id @default(uuid())
  reviewId  String
  userId    String
  isHelpful Boolean  @default(true)
  createdAt DateTime @default(now())
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
}

model ReviewReport {
  id         String             @id @default(uuid())
  reviewId   String
  reporterId String
  reason     String
  status     ReviewReportStatus @default(OPEN)
  createdAt  DateTime           @default(now())
  review     Review             @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reporter   User               @relation(fields: [reporterId], references: [id])

  @@index([status])
}

model Favorite {
  id           String   @id @default(uuid())
  userId       String
  restaurantId String?
  menuItemId   String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  item         MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// -----------------------------------------------------------------
// NOTIFICATIONS / CHAT / TICKETS / ADMIN
// -----------------------------------------------------------------

model Notification {
  id        String              @id @default(uuid())
  userId    String
  title     String
  body      String
  channel   NotificationChannel @default(IN_APP)
  category  String              @default("order") // order | promo | announcement | system
  data      Json?
  isRead    Boolean             @default(false)
  createdAt DateTime            @default(now())
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

model NotificationPreference {
  userId      String  @id
  pushOrders  Boolean @default(true)
  pushPromos  Boolean @default(true)
  emailOrders Boolean @default(true)
  emailPromos Boolean @default(false)
  smsCritical Boolean @default(false)
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChatMessage {
  id        String   @id @default(uuid())
  orderId   String
  senderId  String
  body      String
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sender    User     @relation(fields: [senderId], references: [id])

  @@index([orderId, createdAt])
}

model Ticket {
  id           String         @id @default(uuid())
  number       String         @unique
  creatorId    String
  subject      String
  description  String
  category     TicketCategory @default(OTHER)
  aiCategory   String? // auto-classified by OpenRouter
  priority     Int            @default(3)
  status       TicketStatus   @default(OPEN)
  orderId      String?
  assignedToId String?
  resolution   String?
  refundAmount Decimal?       @db.Decimal(10, 2)
  walletCredit Decimal?       @db.Decimal(10, 2)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  creator  User            @relation("TicketCreator", fields: [creatorId], references: [id])
  order    Order?          @relation(fields: [orderId], references: [id])
  messages TicketMessage[]

  @@index([status, priority, createdAt])
  @@index([assignedToId, status])
}

model TicketMessage {
  id        String   @id @default(uuid())
  ticketId  String
  authorId  String
  body      String
  isStaff   Boolean  @default(false)
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id])

  @@index([ticketId, createdAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String // e.g. restaurant.approve, order.force_cancel
  entity    String?
  entityId  String?
  ip        String?
  meta      Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

model PlatformSetting {
  key       String   @id // commission.rate, loyalty.earn_rate, ...
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt
}

model SurgeZone {
  id           String    @id @default(uuid())
  name         String
  branchId     String?
  centerLat    Decimal   @db.Decimal(10, 7)
  centerLng    Decimal   @db.Decimal(10, 7)
  radiusKm     Decimal   @db.Decimal(5, 2)
  polygon      Json? // optional drawn polygon [[lat,lng],...]
  multiplier   Decimal   @default(1.5) @db.Decimal(4, 2)
  isActive     Boolean   @default(true)
  scheduleFrom DateTime?
  scheduleTo   DateTime?
  daysOfWeek   Int[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  branch       Branch?   @relation("SurgeHomeBranch", fields: [branchId], references: [id])

  @@index([isActive])
}
