# QuickBite mobile (Expo) environment.
# EXPO_PUBLIC_* variables are inlined into the JS bundle at build time —
# never put secrets here; only public URLs/keys.
# For real devices/emulators replace localhost with your LAN IP (e.g. 192.168.1.20).

# Backend REST root (auth refresh, uploads, health)
EXPO_PUBLIC_API_URL=http://localhost:5000

# GraphQL endpoint
EXPO_PUBLIC_GRAPHQL_URL=http://localhost:5000/graphql

# Socket.io server (live tracking / order feeds)
EXPO_PUBLIC_SOCKET_URL=http://localhost:5000

# Public uploads base (menu photos, avatars, proofs)
EXPO_PUBLIC_UPLOADS_URL=http://localhost:5000/uploads

# Google Maps — Android native key (configurable plugin reads this)
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=

# Google Maps — iOS / web key
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Stripe publishable key (pk_test_...) used by the payments sheet
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Branding / locale
EXPO_PUBLIC_APP_NAME=QuickBite
EXPO_PUBLIC_CURRENCY=USD
